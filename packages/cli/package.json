{
  "name": "@labflow/cli",
  "version": "0.0.1",
  "description": "LabFlow CLI - Command-line interface for AI for Science workflows",
  "type": "module",
  "bin": {
    "labflow": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@labflow/core": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.23",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "keywords": [
    "labflow",
    "cli",
    "ai-for-science",
    "research",
    "workflow"
  ],
  "author": "MUSUBI Team",
  "license": "MIT"
}
